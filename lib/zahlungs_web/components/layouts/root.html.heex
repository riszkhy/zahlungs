<!DOCTYPE html>
<html lang="en" data-theme="light" class="h-full bg-green-50">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title default="Zahlungs" suffix=" · POS">
      {assigns[:page_title]}
    </.live_title>
    <link phx-track-static rel="stylesheet" href={~p"/assets/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/app.js"}>
    </script>
  </head>
  <body class="flex flex-col h-full pt-16 text-base-content">
    <%!--
      One slim bar: the cashier's four screens one tap away, the store, and a
      Menu button. Everything else lives in a drawer, so nothing runs off the
      edge of a tablet.
    --%>
    <header class="fixed top-0 left-0 right-0 z-30 bg-green-700 text-white shadow-md" x-data="{ open: false }">
      <div class="mx-auto flex h-16 max-w-7xl items-center gap-3 px-4">
        <a href={~p"/home"} title="Zahlungs Home" class="shrink-0 text-xl font-bold text-white">
          Zahlungs
        </a>

        <.primary_nav :if={assigns[:current_user]} />

        <div class="ml-auto flex items-center gap-2">
          <.store_switcher :if={assigns[:current_scope]} scope={assigns[:current_scope]} />

          <button
            :if={assigns[:current_user]}
            type="button"
            class="nav-tap"
            @click="open = true"
            aria-label="Buka menu"
            aria-controls="menu-drawer"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              aria-hidden="true"
            >
              <line x1="3" y1="12" x2="21" y2="12"></line>
              <line x1="3" y1="6" x2="21" y2="6"></line>
              <line x1="3" y1="18" x2="21" y2="18"></line>
            </svg>
            <span class="hidden sm:inline">Menu</span>
          </button>

          <.link :if={is_nil(assigns[:current_user])} href={~p"/users/log_in"} class="nav-tap">
            Log in
          </.link>
        </div>
      </div>

      <div :if={assigns[:current_user]} x-show="open" x-cloak class="fixed inset-0 z-40 bg-black/40" @click="open = false">
      </div>

      <.menu_drawer
        :if={assigns[:current_user]}
        current_user={assigns[:current_user]}
        current_scope={assigns[:current_scope]}
      />
    </header>

    {@inner_content}

    <footer class="py-3 mt-auto bg-gray-800">
      <div class="container max-w-4xl pb-4 mx-auto text-sm text-center text-gray-300">
        &copy; {DateTime.utc_now().year} Zahlungs
      </div>
    </footer>
  </body>
</html>
