<!DOCTYPE html>
<html lang="id" data-theme="light" class="h-full bg-green-50">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title default="Zahlungs" suffix=" · Zahlungs">
      {assigns[:page_title]}
    </.live_title>
    <link phx-track-static rel="stylesheet" href={~p"/assets/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/app.js"}>
    </script>
  </head>
  <%!--
    The pages before login share this one card, on the app's own colours. No
    image from another site: a shop's LAN may have no internet.
  --%>
  <body class="flex min-h-full flex-col items-center justify-center bg-green-50 px-4 py-10">
    <main role="main" class="w-full max-w-md">
      <.flash_group flash={@flash} />

      <div class="mb-6 text-center">
        <p class="text-3xl font-bold text-green-800">Zahlungs</p>
        <p class="mt-1 text-sm text-gray-600">Kasir &amp; stok untuk toko Anda</p>
      </div>

      <div class="rounded-lg bg-white px-6 py-8 shadow-lg md:px-8">
        {@inner_content}
      </div>
    </main>
  </body>
</html>
