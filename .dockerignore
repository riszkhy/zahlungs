# Build artifacts and local state — the image builds these from source.
_build/
deps/
assets/node_modules/
priv/static/assets/
priv/static/cache_manifest.json
priv/cert/

# VCS / editor / OS noise
.git/
.gitignore
.elixir_ls/
.vscode/
*.swp

# Local secrets and env files must never enter the image.
config/local.secret.exs
*.secret.exs
.env
.env.*

# Docs, CI, and tests are not needed inside the image.
docs/
.github/
test/
README.md
CLAUDE.md
